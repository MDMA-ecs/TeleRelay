{
  "telegram": {
    "api_id": 123456,
    "api_hash": "YOUR_API_HASH",
    "session_name": "MDMA",
    "bot_token": "YOUR_BOT_TOKEN",
    "user_session_name": "MDMA_user",
    "bot_session_name": "MDMA_bot"
  },
  "proxy_pipeline": {
    "enabled": true,
    "sources": [
      "@ProxySourceA",
      "@ProxySourceB"
    ],
    "target_channel": "@YourChannel",
    "test_timeout_sec": 6,
    "good_ms": 250,
    "ok_ms": 900,
    "dedupe_window_hours": 24,
    "post_interval_sec": 2
  },
  "sources": [
    "@ConfigSourceA",
    "@ConfigSourceB"
  ],
  "target_channel": "@YourChannel",
  "post_interval_sec": 2,
  "rename_text": "MDMA",
  "filters": {
    "enabled_protocols": [
      "vless",
      "vmess",
      "trojan",
      "ss"
    ],
    "test_timeout_sec": 8,
    "good_ms": 300,
    "ok_ms": 900,
    "dedupe_window_hours": 24,
    "stability_tries": 3,
    "stability_delay_ms": 250,
    "worker_count": 1,
    "max_queue": 1000,
    "cb_fail_threshold": 30,
    "cb_cooldown_sec": 60,
    "gold_ping_ms": 150,
    "gold_need_ok": 3
  },
  "xray": {
    "binary_path": "xray.exe"
  },
  "curl": {
    "binary_path": "curl"
  },
  "caption": {
    "fixed": "\\n\\n-\\n@YourChannel",
    "medium_template": "{flag} {country} | {latency_ms}ms | {proto}"
  },
  "geoip": {
    "provider": "ip-api",
    "timeout_sec": 6
  },
  "logging": {
    "level": "INFO"
  },
  "db_path": "bot.db",
  "panel": {
    "username": "admin",
    "password": "change_me"
  },
  "switches": {
    "enable_testing": true,
    "enable_ip_check": true,
    "enable_latency": true,
    "enable_geoip": true,
    "enable_send": true
  },
  "buttons": {
    "channel_text": "Natrixo",
    "channel_url": "https://t.me/YourChannel"
  },
  "ip_check": {
    "endpoints": [
      "https://api.ipify.org?format=json",
      "https://api64.ipify.org?format=json",
      "https://ifconfig.me/ip",
      "https://icanhazip.com",
      "https://ipinfo.io/ip"
    ]
  },
  "cloudflare": {
    "enabled": true
  },
  "adaptive_testing": {
    "enabled": true,
    "history_size": 120,
    "min_timeout_sec": 4,
    "max_timeout_sec": 24,
    "min_tries": 1,
    "max_tries": 5,
    "fail_weight": 1.4,
    "stage_weight": 1.0
  }
}
